@model WebAppProject.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container">
    <h2 class="text-center my-4">✏️ Edit Product</h2>

    <form asp-action="Edit" method="post" class="shadow-lg p-4 rounded bg-light">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Product Name:</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Price:</label>
            <input asp-for="Price" class="form-control" required />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary">💾 Save Changes</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ Back</a>
        </div>
    </form>
</div>
