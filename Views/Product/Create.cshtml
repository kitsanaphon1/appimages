@model WebAppProject.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container">
    <h2 class="text-center my-4">➕ Add New Product</h2>

    <form asp-action="Create" method="post" class="shadow-lg p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">Product Name:</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Price:</label>
            <input asp-for="Price" class="form-control" required />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success">✅ Save</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ Back</a>
        </div>
    </form>
</div>
