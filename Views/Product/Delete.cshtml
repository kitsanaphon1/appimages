@model WebAppProject.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container">
    <h2 class="text-center my-4 text-danger">🗑 Delete Product</h2>

    <div class="alert alert-warning text-center">
        <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="text-center">
            <button type="submit" class="btn btn-danger">🗑 Yes, Delete</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">↩️ Cancel</a>
        </div>
    </form>
</div>
